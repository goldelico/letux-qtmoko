#!/bin/bash
# make qtmoko rootfs.tbz from prebuilt package
#
# runs qtmoko.rsh on build server (external Letux Cortex 8 connected through USB)
#

IP=192.168.0.202

[ "$IP" ] || export IP=192.168.2.202

echo "run mqtmoko.rsh on buildhost $IP"
ssh root@$IP <mqtmoko.rsh

DEBIAN=$(ssh root@192.168.0.202 sh -c "cd; cd /qtmoko && cat etc/debian_version")

[ "$DEBIAN" ] || exit 1

UPLOAD="/Library/WebServer/Sites/download.goldelico.com/letux-debian-rootfs/"
FILE="$UPLOAD$(date "+%Y%m%d")-wheezy-$DEBIAN-qtmoko57.tbz"

echo "pull image from buildhost $IP to $FILE"

scp root@$IP:/qtmoko.tbz "$FILE"
ls -l $UPLOAD
