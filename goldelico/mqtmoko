#!/bin/bash
# make qtmoko rootfs.tbz from prebuilt package
#
# runs qtmoko.sh in qemu (Wheezy) image
#

[ "$IP" ] || export IP=192.168.2.202
[ "$SERVER" ] || export SERVER="http://download.goldelico.com/gta04/qtmoko"
[ "$UPLOAD" ] || export UPLOAD="/Volumes/Server HD/Library/WebServer/Sites/download.goldelico.com/gta04/qtmoko/unstable.tbz"

[ -x "$UPLOAD" ] || {
	echo "server down - can't reach $UPLOAD"
	mkdir -p "/Volumes/Server HD/"
#	mount_afp "afp://hns:PASSWD@www.goldelico.com/Server HD" "/Volumes/Server HD/"	# try to mount
	mount_smbfs "//hns:$(cat ~/.ssh/www.goldelico.com)@www.goldelico.com/Server%20HD" /Volumes/Server\ HD || exit 1
}

echo "run mqtmoko.rsh on buildhost $IP"
( cd qemu-wheezy-vexpress && ./connect.sh -u ) <mqtmoko.rsh

echo "pull image from qemu"
( cd qemu-wheezy-vexpress && ./connect.sh -d sh -c 'cd; cd /media/rootfs && tar cf - .') >unstable.tar
ls -l unstable.tar

echo "compress"
rm -f unstable.tar.bz2
[ -s unstable.tar ] && bzip2 -f unstable.tar # compress on host because that is much faster
echo "upload to $UPLOAD"
ls -l unstable.tar*
mv -f unstable.tar.bz2 "$UPLOAD"

echo "result"
ls -l "$UPLOAD"

exit
