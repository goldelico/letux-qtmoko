#!/bin/bash
# make qtmoko packages from sources
#
# 1. runs Wheezy in qemu or on a connected ARM machine
# 2. runs the mbuild.rsh on that machine
# 3. pulls the results and uploads to download area
#

[ "$IP" ] || export IP=192.168.2.202
[ "$VERSION" ] || export VERSION=58
[ "$UPLOAD" ] || export UPLOAD="/Volumes/Server HD/Library/WebServer/Sites/download.goldelico.com/gta04/qtmoko/"

[ -x "$UPLOAD" ] || {
	echo "server down - can't reach $UPLOAD"
	mkdir -p "/Volumes/Server HD/"
#	mount_afp "afp://hns:PASSWD@www.goldelico.com/Server HD" "/Volumes/Server HD/"	# try to mount
	mount_smbfs "//hns:$(cat ~/.ssh/www.goldelico.com)@www.goldelico.com/Server%20HD" /Volumes/Server\ HD || exit 1
}

echo "mbuild: building unstable.tbz Version $VERSION for $UPLOAD on $IP"
( cd qemu-wheezy-vexpress && ./connect.sh -u ) <mbuild.rsh

echo "mbuild: pull image from $IP"
( cd qemu-wheezy-vexpress && ./connect.sh -d ) >qtmoko-gta04.tar <<END
cd
cd qtmoko && tar cf - packages
END

ls -l qtmoko-gta04.tar

echo "mbuild: compress"
rm -f qtmoko-gta04.tar.bz2
[ -r qtmoko-gta04.tar ] && bzip2 -f qtmoko-gta04.tar # compress on host because that is much faster
echo "mbuild: upload to $UPLOAD"
ls -l qtmoko-gta04.tar*
mv -f qtmoko-gta04.tar.bz2 "$UPLOAD/qtmoko-gta04_${VERSION}-1_armhf.deb"

echo "mbuild: result"
ls -l "$UPLOAD"

exit
