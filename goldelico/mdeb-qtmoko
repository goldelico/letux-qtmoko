#!/bin/bash
# build the qtmoko.deb packages from sources
#
# 1. runs Wheezy in qemu or on a connected ARM machine
# 2. runs the mbuild.rsh on that machine
# 3. pulls the results and uploads to download area
#
# call with -s option to sync from git and debian repos

IP=192.168.0.202

SOURCE=/qtmoko-build/qtmoko-src

[ "$IP" ] || export IP=192.168.2.202
[ "$VERSION" ] || export VERSION=57

echo "mdeb-qtmoko: building qtmoko-gta04_${VERSION}-1_armhf.deb Version $VERSION on $IP"
ssh root@$IP "bash -s -- -v v$VERSION $@" <mdeb-qtmoko.rsh || exit 1

# FIXME: for this to correctly work for different versions we must parse -v here
echo "mdeb-qtmoko: copy to server"
mkdir -p /Library/WebServer/Sites/www.qtmoko.net/download/dists/wheezy/main/binary-armhf
scp root@192.168.0.202:/qtmoko-build/qtmoko-gta04_$VERSION-1_armhf.deb /Library/WebServer/Sites/www.qtmoko.net/download/dists/wheezy/main/binary-armhf
mkdir -p /Library/WebServer/Sites/www.qtmoko.net/download/dists/wheezy/main/source
scp root@192.168.0.202:/qtmoko-build/qtmoko_$VERSION-1.dsc /Library/WebServer/Sites/www.qtmoko.net/download/dists/wheezy/main/source
scp root@192.168.0.202:/qtmoko-build/qtmoko_$VERSION-1_armhf.changes /Library/WebServer/Sites/www.qtmoko.net/download/dists/wheezy/main/source
scp root@192.168.0.202:/qtmoko-build/qtmoko_$VERSION-1.tar.gz /Library/WebServer/Sites/www.qtmoko.net/download/dists/wheezy/main/source
