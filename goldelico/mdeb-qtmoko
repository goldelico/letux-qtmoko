#!/bin/bash
# build the qtmoko.deb packages from sources
#
# 1. runs Wheezy in qemu or on a connected ARM machine
# 2. runs the mbuild.rsh on that machine
# 3. pulls the results and uploads to download area
#

IP=192.168.0.202

CHROOT=/qtmoko-build
SOURCE=/qtmoko-src
SERVER=/Library/WebServer/Sites/www.qtmoko.net/download/dists/wheezy/main

[ "$IP" ] || export IP=192.168.2.202

echo "mdeb-qtmoko: building qtmoko-gta04_\$VERSION-1_armhf.deb on $IP"
ssh root@$IP "bash -s -- $@" <mdeb-qtmoko.rsh || exit 1

echo "mdeb-qtmoko: pull all Debian packages from $IP and send to server"

ssh root@$IP bash <<END | ( mkdir -p $SERVER/binary-armhf && cd $SERVER/binary-armhf && tar xvjf - )
find $CHROOT -name 'qtmoko*_armhf.deb' | ( while read FILE
do # collect all .deb and flatten
FILES+=" -C \$(dirname "\$FILE") \$(basename "\$FILE")"
done
# echo \$FILES
tar cjf - \$FILES
)
END

ssh root@$IP bash <<END | ( mkdir -p $SERVER/source && cd $SERVER/source && tar xvjf - )
find $CHROOT -name 'qtmoko*.dsc' -o -name 'qtmoko*.changes' -o -name 'qtmoko*.tar.gz' | ( while read FILE
do # collect all .dsc and flatten
FILES+=" -C \$(dirname "\$FILE") \$(basename "\$FILE")"
done
# echo \$FILES
tar cjf - \$FILES
)
END
