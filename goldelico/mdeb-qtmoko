#!/bin/bash
# build the qtmoko.deb packages from sources
#
# 1. runs Wheezy in qemu or on a connected ARM machine
# 2. runs the mbuild.rsh on that machine
# 3. pulls the results and uploads to download area
#
# call with -s option to sync from git and debian repos

IP=192.168.0.202

SOURCE=/qtmoko-build/qtmoko-src

[ "$IP" ] || export IP=192.168.2.202
[ "$VERSION" ] || export VERSION=56

echo "mdeb-qtmoko: building qtmoko-gta04_${VERSION}-1_armhf.deb Version $VERSION on $IP"
ssh root@$IP <mdeb-qtmoko.rsh || exit 1

# FIXME: pull all .deb files to http://download.goldelico.com/letux-debian-rootfs/debian/dists/

ssh root@$IP -v $VErSION "$@" >qtmoko-gta04.tar <<END
cd
cd "$SOURCE" && tar cf - packages
END
