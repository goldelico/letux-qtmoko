#!/bin/bash
# build the qtmoko.deb packages from sources
#

# echo $@

HOST=192.168.0.202
USER=root
PORT=

CHROOT=/qtmoko-build
SOURCE=/qtmoko-src

while [ "$1" ]
do
	case "$1" in
		-e ) HOST=192.168.2.106;;	# eeePC
		-o ) HOST=192.168.0.202;;	# online
		-n ) HOST=192.168.0.202;;	# native
		-vb )	# virtual box
			VM="Debian64 Jessie Master"	# buildhost
			PORT=3022	# choose different ports for different VMs
			HOST=localhost
			if false
			then
				VBoxManage controlvm "$VM" savestate
				VBoxManage modifyvm "$VM" --natpf1 "ssh,tcp,,$PORT,,22"
				VBoxManage startvm "$VM"
				sleep 5
			fi
			;;
		wheezy | jessie | stretch )
			DEBIAN="$1";;	# target
		* ) break;;
	esac
	shift
done

[ "$HOST" ] || export HOST=192.168.2.202
[ "$DEBIAN" ] || export DEBIAN=wheezy
[ "$PORT" ] && SSHFLAG="-p $PORT"

SERVER=/Library/WebServer/Sites/www.qtmoko.net/download/dists/$DEBIAN/main

VERSION=v56

echo "mdeb-qtmoko: building qtmoko-gta04_$VERSION-1_armhf.deb on $SSHFLAG $USER@$HOST"

# FIXME: pass down $DEBIAN
ssh -o StrictHostKeyChecking=no $SSHFLAG $USER@$HOST "bash -s -- $@" <mdeb-qtmoko.rsh || exit 1

echo "mdeb-qtmoko: pull all Debian packages from $PFLAG $USER:$IP and send to server"

# binaries

ssh -o StrictHostKeyChecking=no $SSHFLAG $USER@$HOST bash <<END | ( mkdir -p $SERVER/binary-armhf && cd $SERVER/binary-armhf && tar xvjf - )
find $CHROOT -name 'qtmoko*_armhf.deb' | ( while read FILE
do # collect all .deb and flatten
FILES+=" -C \$(dirname "\$FILE") \$(basename "\$FILE")"
done
# echo \$FILES
tar cjf - \$FILES
)
END

# sources

ssh -o StrictHostKeyChecking=no $SSHFLAG $USER@$HOST bash <<END | ( mkdir -p $SERVER/source && cd $SERVER/source && tar xvjf - )
find $CHROOT -name 'qtmoko*.dsc' -o -name 'qtmoko*.changes' -o -name 'qtmoko*.tar.gz' | ( while read FILE
do # collect all .dsc and flatten
FILES+=" -C \$(dirname "\$FILE") \$(basename "\$FILE")"
done
# echo \$FILES
tar cjf - \$FILES
)
END

